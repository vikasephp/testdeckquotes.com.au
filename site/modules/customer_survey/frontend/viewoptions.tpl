<div align="center" style="min-height:350px; z-index:9999999;">
    <h3 class="page-title"><br />Options List</h3>    
   
   
<form name="detail" method="post" action=""  enctype="multipart/form-data">
<div style="float:right; margin-right:10px; background: #09F; color:#FFF !important; padding:6px; margin-bottom:5px;"> 
<a href="{{$BASE_URL}}customer_survey.add_option" class="various" title="Edit" style="color:#FFF; text-decoration:none; font-size:14px;"> Add New Option </a>
</div>


<table id="list-table" width="99%">
<tr> 
<th width="10%">SrNO</th><th width="50%">Survey Option </th><th>Survey Link</th><th width="10%">Action</th>
       {{foreach from=$taskdata key="key" item="item"}}
       <tr>
      	 
        <td>{{counter}}</td>
        <td>{{$item.so_name}}</td>
        <td style="text-align:center;">{{if $item.so_survey_link}}<a href="{{$item.so_survey_link}}" target="_blank">Link</a>{{/if}}</td>
           
        <td> <a href="{{$BASE_URL}}customer_survey.add_option/so_id/{{$item.so_id}}" class="various" title="Edit"> 
             <img style="height:20px; width:20px;" src="{{$BASE_URL}}css/admin/images/edit.png"/></a>&nbsp;&nbsp;
             
         <a href="{{$BASE_URL}}customer_survey.delete_option/so_id/{{$item.so_id}}" onclick="javascript:if(!confirm('Are you sure want to delete the Option?')) return false;" title="Delete">     <img style="height: 16px;; width:16px" src="{{$BASE_URL}}css/admin/images/deletecross.png"/></a>
         </td>    
       </tr> 
      {{/foreach}}

</table><br /><br />
<input type="button" name="btnCancelDetail" value="Close" onclick="javascript:closepop();" class="vsml" />
</form>
    
    <script type="text/javascript">
		function closepop()
		{
		setTimeout('parent.close_win();', 500);
		}
	</script>
    
