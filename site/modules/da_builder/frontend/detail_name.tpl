<div align="center" style="min-height:350px;">
    <h3 class="page-title">Add New Report Name</h3>    
   
   
<form name="detail" method="post" action="{{$XFA.detail}}"  enctype="multipart/form-data">
<table id="list-table" width="100%">
    <input type="hidden" name="report[rb_id]" value="{{$detail.rb_id}}" />
   {{if $error}} <tr><th colspan="2" style="color:#FF0000;">{{$error}}</th></tr>{{/if}}
   
  
   <tr>
     <th>Report Name</th>
     <td><input  type="text" name="report[rb_report_name]"  value="{{$detail.rb_report_name}}" style="width:700px;"  required="required"/> </td>
    </tr>
   
        
      
     <tr>
        <td colspan="2" style="text-align:center;">
          <input type="submit" name="subAddDetail" value="Save" class="vsml" />
          <input type="button" name="btnCancelDetail" value="Close" onclick="javascript:closepop();" class="vsml" />
        </td>
    </tr>
</table>
</form>
    
        <script type="text/javascript">
		function closepop()
		{
		setTimeout('parent.close_win();', 500);
		}
	</script>
    
	
</div>

